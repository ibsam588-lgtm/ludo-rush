<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080B13</item>
        <item name="android:navigationBarColor">#080B13</item>
        <item name="android:colorAccent">#1E88E5</item>
    </style>

    <!-- Applied at runtime via getWindow() when light theme is active -->
    <style name="AppTheme.Light" parent="AppTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F4FF</item>
        <item name="android:navigationBarColor">#F2F4FF</item>
    </style>

    <style name="DialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#E8293E</item>
    </style>
</resources>
