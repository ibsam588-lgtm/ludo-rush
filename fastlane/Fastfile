default_platform(:android)

platform :android do
  desc "Upload the Android App Bundle to the Google Play internal testing track"
  lane :internal do |options|
    aab_path = options[:aab_path] || ENV["AAB_PATH"]

    UI.user_error!("aab_path is required") if aab_path.to_s.empty?
    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is required") if ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.empty?

    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.ludorush.game"),
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      aab: aab_path,
      track: "internal",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload store listing metadata and artwork without uploading a build"
  lane :metadata do
    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is required") if ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.empty?

    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.ludorush.game"),
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_aab: true,
      skip_upload_apk: true,
      metadata_path: ENV.fetch("PLAY_METADATA_PATH", "./fastlane/metadata/android"),
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Update Play Store app details and public contact info"
  lane :app_details do
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.ludorush.game")
    json_key_data = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"]

    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is required") if json_key_data.to_s.empty?

    require "google/apis/androidpublisher_v3"
    require "googleauth"
    require "stringio"

    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.client_options.application_name = "Ludo Rush CI"
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: StringIO.new(json_key_data),
      scope: Google::Apis::AndroidpublisherV3::AUTH_ANDROIDPUBLISHER
    )

    edit = service.insert_edit(package_name)
    details = service.get_edit_detail(package_name, edit.id)
    details.contact_email = ENV.fetch("PLAY_CONTACT_EMAIL", "labscorsair@gmail.com")
    details.contact_website = ENV.fetch("PLAY_CONTACT_WEBSITE", "https://corsairlabs.com")

    contact_phone = ENV["PLAY_CONTACT_PHONE"].to_s.strip
    details.contact_phone = contact_phone unless contact_phone.empty?

    service.update_edit_detail(package_name, edit.id, details)
    service.commit_edit(package_name, edit.id)

    UI.success("Updated Play Store app details for #{package_name}")
  end

  desc "Upload the Android App Bundle to Google Play Internal App Sharing"
  lane :internal_app_sharing do |options|
    aab_path = options[:aab_path] || ENV["AAB_PATH"]

    UI.user_error!("aab_path is required") if aab_path.to_s.empty?
    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is required") if ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.empty?

    upload_to_play_store_internal_app_sharing(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.ludorush.game"),
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      aab: aab_path
    )
  end
end
